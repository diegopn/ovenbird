  <releases>
    <release version="0.3.0" date="2026-10-21" type="stable">
      <description>
        <p>Long reference titles and author names now wrap within the list instead of causing horizontal scrolling. The release also adds updated screenshots for the editor and reference manager.</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-10-12" type="stable">
      <description>
        <p>Preferences now let you choose the startup view, reopen the last project, and set the default folder for file dialogs. Large reference, tag, and author lists are now virtualized for smoother navigation, and the editor and reference manager received visual refinements for light and dark themes.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-09" type="stable">
    </release>
  </releases>
