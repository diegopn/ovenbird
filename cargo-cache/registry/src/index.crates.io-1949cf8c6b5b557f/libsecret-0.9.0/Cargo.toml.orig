[package]
name = "libsecret"
version = "0.9.0"
rust-version = "1.92.0" # Match min requirement from gtk-rs-core
authors = [
  "Sebastian Wiesner <sebastian@swsnr.de>",
  "Maximiliano Sandoval <msandova@gnome.org>",
  "Sophie Herold <sophie@hemio.de>",
]
edition = "2024"
exclude = ['gir-files/*', 'gir/']
readme = "../README.md"
license = 'MIT'
repository = 'https://gitlab.gnome.org/World/Rust/libsecret-rs'
documentation = "https://world.pages.gitlab.gnome.org/Rust/libsecret-rs/libsecret"
categories = ["api-bindings"]
description = "Rust bindings of libsecret"
homepage = 'https://gitlab.gnome.org/World/Rust/libsecret-rs'
keywords = ["libsecret", "dbus", "secret", "bindings", "freedesktop"]

[dependencies]
libc = "0.2"

[dependencies.glib]
version = "0.22"

[dependencies.gio]
version = "0.22"

[dependencies.ffi]
package = "libsecret-sys"
path = './sys'
version = "0.9"

[features]
default = ["v0_18"]
v0_18 = ["ffi/v0_18"]
v0_18_6 = ["v0_18", "ffi/v0_18_6"]
v0_19 = ["v0_18_6", "ffi/v0_19"]
v0_20 = ["v0_19", "ffi/v0_20"]
v0_21 = ["v0_20", "ffi/v0_21"]
v0_21_2 = ["v0_21", "ffi/v0_21_2"]

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]
